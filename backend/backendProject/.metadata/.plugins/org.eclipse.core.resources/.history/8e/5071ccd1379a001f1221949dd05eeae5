package bankingSystemBackend.dao;

import java.util.UUID;

import bankingSystemBackend.model.Account;
import bankingSystemBackend.model.CustomerInfo;

public interface AccountDAO {
    boolean insertAccount(UUID id, Account account, CustomerInfo customer);
    
    boolean addCustomerToAccount(UUID accountID, CustomerInfo customer);
    
    default boolean addAccount(CustomerInfo customer){
        UUID id = UUID.randomUUID();
        Account account = new Account(id, 0);
        return insertAccount(id, account, customer);
    }
} 
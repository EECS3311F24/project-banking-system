package bankingSystemBackend.api;

import com.sun.net.httpserver.HttpExchange;
import com.sun.net.httpserver.HttpHandler;
import java.io.IOException;
import java.io.OutputStream;
import java.util.UUID;

import org.json.JSONException;
import org.json.JSONObject;

import bankingSystemBackend.service.CustomerInfoService;
import bankingSystemBackend.utils.Utils;
import bankingSystemBackend.model.CustomerInfo;

public class CustomerInfoController implements HttpHandler{
	
    private static CustomerInfoService customerInfoService;

    public CustomerInfoController(CustomerInfoService customerInfoService){
        this.customerInfoService = customerInfoService;
    }

    public void handle(HttpExchange r){
        try {
            if (r.getRequestMethod().equals("POST")){
                handlePost(r);
            } else if (r.getRequestMethod().equals("GET")){ 
                handleGet(r);
            } else if (r.getRequestMethod().equals("PUT")){
                handlePut(r);
            } else if (r.getRequestMethod().equals("DELETE")){
                handleDelete(r);
            }
        } catch (Exception e) {
            e.printStackTrace();
        }
    }
    
    // add customerInfo
    public void handlePost(HttpExchange r) throws IOException, JSONException{ 
        String body = Utils.convert(r.getRequestBody());
        JSONObject deserialized = new JSONObject(body);
        
        if (!deserialized.has("customerMail") || 
        	!deserialized.has("customerPass") ||
        	!deserialized.has("customerMobileNum") ||
        	!deserialized.has("customerAddress")) 
        {
        	r.sendResponseHeaders(400, -1);
        	return;
        }
        
        customerInfoService.addCustomerInfo(
        		new CustomerInfo(
        			null, 
        			deserialized.getString("customerMail"), 
        			deserialized.getString("customerPass"), 
        			deserialized.getString("customerMobileNum"), 
        			deserialized.getString("customerAddress")
        		));
        
        r.sendResponseHeaders(200, -1);
    }

    public void handleGet(HttpExchange r) throws IOException, JSONException{
    	String body = Utils.convert(r.getRequestBody());
        JSONObject deserialized = new JSONObject(body);
        
        // get user from mail + password
        if (deserialized.length() == 2 && deserialized.has("customerMail") && deserialized.has("customerPass")) { 
        	CustomerInfo customer = customerInfoService.getCustomerInfoFromMailAndPass(deserialized.getString("customerMail"), deserialized.getString("customerPass"));
        	
        	if (customer == null) {
        		r.sendResponseHeaders(404, -1);
        		return;
        	}
        	
        	String response = new JSONObject()
        			.put("customerID", customer.getCustomerID())
        			.put("customerMail", customer.getEmail())
        			.put("customerPass", customer.getPassword())
        			.put("customerMobileNum", customer.getMobileNum())
        			.put("customerAddress", customer.getAddress())
        			.toString();
        	
        	r.sendResponseHeaders(200, response.length());
        	OutputStream os = r.getResponseBody();
        	os.write(response.getBytes());
        	os.close();
        	return;
        }
        
     // get user from id
        if (deserialized.length() == 1 && deserialized.has("customerID")) { 
        	CustomerInfo customer = customerInfoService.getCustomerInfoFromID(UUID.fromString(deserialized.getString("customerID")));
        	
        	if (customer == null) {
        		r.sendResponseHeaders(404, -1);
        		return;
        	}
        	
        	String response = new JSONObject()
        			.put("customerID", customer.getCustomerID())
        			.put("customerMail", customer.getEmail())
        			.put("customerPass", customer.getPassword())
        			.put("customerMobileNum", customer.getMobileNum())
        			.put("customerAddress", customer.getAddress())
        			.toString();
        	
        	r.sendResponseHeaders(200, response.length());
        	OutputStream os = r.getResponseBody();
        	os.write(response.getBytes());
        	os.close();
        	return;
        }
        
        r.sendResponseHeaders(400, -1);
    }

    public void handlePut(HttpExchange r) throws IOException, JSONException{
    	String body = Utils.convert(r.getRequestBody());
        JSONObject deserialized = new JSONObject(body);
        
        String newPassword = null;
        String newMobileNum = null;
        String newAddress = null;
        
        if (deserialized.has("newPassword")) newPassword = deserialized.getString("newPassword");
        if (deserialized.has("newMobileNum")) newMobileNum = deserialized.getString("newMobileNum");
        if (deserialized.has("newAddress")) newAddress = deserialized.getString("newAddress");
        
         if (customerInfoService.changeCustomerInfo(UUID.fromString((String) deserialized.get("customerID")),
        		 									newPassword, 
        		 									newMobileNum, 
        		 									newAddress)) 
         {
        	 r.sendResponseHeaders(200, -1);
         } else {
        	 r.sendResponseHeaders(400, -1);
         }
    }

    public void handleDelete(HttpExchange r) throws IOException, JSONException{
    	String body = Utils.convert(r.getRequestBody());
        JSONObject deserialized = new JSONObject(body);
        
        // get user from email + password
        if (deserialized.length() == 1 && deserialized.has("customerID")) { 
        	
        	if (customerInfoService.removeCustomer(UUID.fromString((String) deserialized.get("customerID")))) {
        		r.sendResponseHeaders(200, -1);
        		return;
        	} 
        	
        	r.sendResponseHeaders(404, -1);
        	return;
        }
        
        r.sendResponseHeaders(400, -1);
    }
}
